// Cloudflare Workers static assets config (replaces Vercel hosting).
// The site is fully static, so there is no Worker script: Cloudflare serves ./dist.
{
  "name": "angel-bail-bonds",
  "compatibility_date": "2026-11-15",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
