---
import BaseLayout from '../layouts/BaseLayout.astro';

const faqData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How often is the Lincoln County jail roster updated?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Lincoln County Sheriff's Office says its online inmate search is updated hourly."
      }
    },
    {
      "@type": "Question",
      "name": "Where is the Lincoln County Court Clerk?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "811 Manvel Ave, Suite 9, Chandler, OK 74834, in the same building as the jail. Phone (405) 258-1309, open 8:00 a.m. to 4:30 p.m. Monday to Friday."
      }
    },
    {
      "@type": "Question",
      "name": "How do I put money on a Lincoln County inmate's account?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Use the Prodigy kiosk in the Sheriff's Office lobby with cash or a credit card, or bring a money order. In-person deposits are 8:30 a.m. to 4:30 p.m. Monday to Friday."
      }
    },
    {
      "@type": "Question",
      "name": "How many video visits are allowed at Lincoln County Jail?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Two visits per day, 20 minutes each, scheduled through Prodigy at least 24 hours in advance, with up to three visitors including children."
      }
    }
  ]
};
const breadcrumbData = {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://stillwaterokbailbonds.com/"}, {"@type": "ListItem", "position": 2, "name": "Lincoln County Bail Bonds", "item": "https://stillwaterokbailbonds.com/lincoln-county-bail-bonds"}, {"@type": "ListItem", "position": 3, "name": "Lincoln County Inmate Search", "item": "https://stillwaterokbailbonds.com/lincoln-county-inmate-search"}]};
const webPageData = {"@context": "https://schema.org", "@type": "WebPage", "name": "Lincoln County Inmate Search", "url": "https://stillwaterokbailbonds.com/lincoln-county-inmate-search", "dateModified": "2026-11-15", "about": {"@type": "GovernmentBuilding", "name": "Lincoln County Jail", "address": {"@type": "PostalAddress", "streetAddress": "811 Manvel Ave, Suite 14", "addressLocality": "Chandler", "postalCode": "74834", "addressRegion": "OK", "addressCountry": "US"}, "telephone": "+1-405-258-1191"}, "publisher": {"@type": "LocalBusiness", "name": "Angel Bail Bonds", "telephone": "+1-405-614-3000", "address": {"@type": "PostalAddress", "streetAddress": "800 E 6th Ave, Ste Z", "addressLocality": "Stillwater", "addressRegion": "OK", "postalCode": "74075", "addressCountry": "US"}}};
---

<BaseLayout
  title="Lincoln County Inmate Search | Lincoln County Jail Roster, Chandler OK"
  description="Search the Lincoln County Jail roster in Chandler, OK (updated hourly), look up the court case, add money through Prodigy and book a video visit. Bail bonds 24/7: (405) 614-3000."
  structuredData={webPageData}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqData)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />

  <section style="background: linear-gradient(135deg, var(--navy-deep) 0%, var(--navy) 100%); padding: 52px 1.5rem 44px;">
    <div style="max-width: 820px; margin: 0 auto;">
      <p style="color: rgba(255,255,255,0.55); font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 10px;"><a href="/lincoln-county-bail-bonds" style="color: inherit;">Lincoln County Bail Bonds</a> › Inmate Search</p>
      <h1 style="color: white; font-size: clamp(1.6rem, 4vw, 2.3rem); line-height: 1.2; font-weight: 800; margin-bottom: 14px;">Lincoln County Inmate Search</h1>
      <p style="color: rgba(255,255,255,0.8); font-size: 1.02rem; line-height: 1.7; margin-bottom: 22px;">The Lincoln County Sheriff's Office keeps an online roster of everyone held at the Lincoln County Jail in Chandler, and says it is updated hourly. It lists booking date and charges, not the bond. The jail and the Court Clerk share the same address, 811 Manvel Ave.</p>
      <div style="display:flex; gap:12px; flex-wrap:wrap;">
        <a href="https://lincolncountysheriffok.gov/inmate-search" rel="nofollow noopener" target="_blank" class="btn-primary" style="background: white; color: var(--navy); padding: 12px 22px;">Open the official roster ↗</a>
        <a href="tel:+14056143000" class="btn-primary" style="padding: 12px 22px;">Call us to find them: (405) 614-3000</a>
      </div>
    </div>
  </section>

  <section style="padding: 40px 1.5rem; background: white;">
    <div style="max-width: 820px; margin: 0 auto;">
      <h2 style="color: var(--navy); font-size: 1.35rem; font-weight: 800; margin-bottom: 14px;">How to look someone up in Lincoln County Jail</h2>
      <ol style="color: var(--slate-600); line-height: 1.7; padding-left: 1.2rem; list-style: decimal;">
        <li style="margin-bottom:10px;">Open the <a href="https://lincolncountysheriffok.gov/inmate-search" rel="nofollow noopener" target="_blank" style="color: var(--blue);">Lincoln County inmate search</a>. The Sheriff's Office says it updates hourly.</li>
        <li style="margin-bottom:10px;">Write down the booking date and every charge. Charges from a Turner Turnpike or Route 66 stop can include a traffic offense and a criminal one, each with its own bond.</li>
        <li style="margin-bottom:10px;">Look up the court case: the Court Clerk links both <a href="https://www.oscn.net/courts/lincoln" rel="nofollow noopener" target="_blank" style="color: var(--blue);">OSCN</a> and <a href="https://odcr.com/" rel="nofollow noopener" target="_blank" style="color: var(--blue);">ODCR</a>. A new arrest may not have a case number for a day or two.</li>
        <li style="margin-bottom:10px;">Call Angel Bail Bonds at <a href="tel:+14056143000" style="color: var(--blue);">(405) 614-3000</a>. We confirm the bond with the jail and the clerk and walk you through the release.</li>
      </ol>
    </div>
  </section>

  <section style="padding: 40px 1.5rem; background: var(--slate-50);">
    <div style="max-width: 820px; margin: 0 auto;">
      <h2 style="color: var(--navy); font-size: 1.35rem; font-weight: 800; margin-bottom: 14px;">Lincoln County Jail at a glance</h2>
      <div style="overflow-x:auto;"><table style="width:100%; border-collapse:collapse; background:white; border:1px solid var(--slate-200); border-radius:10px; font-size:0.95rem;">
        <tbody>
          <tr><th scope="row" style="text-align:left; padding:10px 12px; color:var(--navy); font-weight:700; vertical-align:top; width:34%;">Address</th><td style="padding:10px 12px; color:var(--slate-600);">811 Manvel Ave, Suite 14, Chandler, OK 74834</td></tr>
          <tr><th scope="row" style="text-align:left; padding:10px 12px; color:var(--navy); font-weight:700; vertical-align:top; width:34%;">Sheriff non-emergency</th><td style="padding:10px 12px; color:var(--slate-600);"><a href="tel:+14052581191" style="color: var(--blue);">(405) 258-1191</a></td></tr>
          <tr><th scope="row" style="text-align:left; padding:10px 12px; color:var(--navy); font-weight:700; vertical-align:top; width:34%;">Roster</th><td style="padding:10px 12px; color:var(--slate-600);">Updated hourly; shows booking date and charges</td></tr>
          <tr><th scope="row" style="text-align:left; padding:10px 12px; color:var(--navy); font-weight:700; vertical-align:top; width:34%;">Court Clerk</th><td style="padding:10px 12px; color:var(--slate-600);">Same building, Suite 9 · <a href="tel:+14052581309" style="color: var(--blue);">(405) 258-1309</a> · 8:00 a.m. to 4:30 p.m., Monday to Friday</td></tr>
          <tr><th scope="row" style="text-align:left; padding:10px 12px; color:var(--navy); font-weight:700; vertical-align:top; width:34%;">Money for inmates</th><td style="padding:10px 12px; color:var(--slate-600);">Prodigy: lobby kiosk (cash or card) or money order; in-person deposits 8:30 a.m. to 4:30 p.m., Monday to Friday</td></tr>
          <tr><th scope="row" style="text-align:left; padding:10px 12px; color:var(--navy); font-weight:700; vertical-align:top; width:34%;">Video visits</th><td style="padding:10px 12px; color:var(--slate-600);">Prodigy; 2 visits a day, 20 minutes each, booked 24 hours ahead</td></tr>
        </tbody>
      </table></div>
      <p style="color: var(--slate-500); font-size: 0.82rem; margin-top: 10px;">Checked against the official pages listed at the bottom of this page on November 15, 2026. Jails change vendors and hours, so confirm with the jail before you drive.</p>
    </div>
  </section>

  <section style="padding: 40px 1.5rem; background: white;">
    <div style="max-width: 820px; margin: 0 auto;">
      <h2 style="color: var(--navy); font-size: 1.35rem; font-weight: 800; margin-bottom: 14px;">Jail and courthouse under one roof</h2>
      <p style="color: var(--slate-600); line-height: 1.75; margin-bottom: 12px;">Lincoln County lists the Sheriff's Office and jail at <strong>811 Manvel Ave, Suite 14</strong> and the Court Clerk at <strong>Suite 9</strong> of the same address in Chandler. When a bond needs to be filed with the clerk during business hours, that is a short walk instead of a drive across town.</p>
      <p style="color: var(--slate-600); line-height: 1.75; margin-bottom: 12px;">The Court Clerk is open <strong>8:00 a.m. to 4:30 p.m., Monday to Friday</strong>, (405) 258-1309.</p>
    </div>
  </section>
  <section style="padding: 40px 1.5rem; background: var(--slate-50);">
    <div style="max-width: 820px; margin: 0 auto;">
      <h2 style="color: var(--navy); font-size: 1.35rem; font-weight: 800; margin-bottom: 14px;">Money and video visits</h2>
      <p style="color: var(--slate-600); line-height: 1.75; margin-bottom: 12px;">Lincoln County uses <strong>Prodigy Solutions</strong> for both commissary and visits.</p>
      <ul style="color: var(--slate-600); line-height: 1.75; padding-left: 1.2rem; list-style: disc; margin-bottom: 12px;">
        <li><strong>Deposits:</strong> the kiosk in the office lobby takes cash or credit card; money orders are also accepted. In-person deposits run 8:30 a.m. to 4:30 p.m., Monday to Friday.</li>
        <li><strong>Remote video visits:</strong> listed as 6:00 a.m. to 10:00 p.m., except 11:00 a.m. to 1:00 p.m. and 5:00 to 7:00 p.m.</li>
        <li><strong>Limit:</strong> 2 visits per day, 20 minutes each, booked at least 24 hours in advance</li>
        <li><strong>Group size:</strong> up to three visitors, children included</li>
        <li>No internet at home? A few Saturday kiosk visits are available in the detention center lobby, also booked 24 hours ahead.</li>
      </ul>
    </div>
  </section>
  <section style="padding: 40px 1.5rem; background: white;">
    <div style="max-width: 820px; margin: 0 auto;">
      <h2 style="color: var(--navy); font-size: 1.35rem; font-weight: 800; margin-bottom: 14px;">Turnpike and Route 66 arrests</h2>
      <p style="color: var(--slate-600); line-height: 1.75; margin-bottom: 12px;">Lincoln County sits on the Turner Turnpike and old Route 66 between Oklahoma City and Tulsa. If your family member was arrested while traveling through, you do not need to be in Chandler to get started: call us and we can begin the bail process by phone.</p>
      <p style="color: var(--slate-600); line-height: 1.75; margin-bottom: 12px;">Oklahoma VINE (toll-free 877-654-8463) can notify you when their custody status changes.</p>
    </div>
  </section>

  <section style="padding: 40px 1.5rem; background: var(--slate-50);">
    <div style="max-width: 820px; margin: 0 auto;">
      <h2 style="color: var(--navy); font-size: 1.35rem; font-weight: 800; margin-bottom: 14px;">Questions families ask</h2>
      <details style="border:1px solid var(--slate-200); border-radius:10px; padding:14px 16px; margin-bottom:10px; background:white;">
        <summary style="font-weight:700; color:var(--navy); cursor:pointer;">How often is the Lincoln County jail roster updated?</summary>
        <p style="color: var(--slate-600); margin-top: 10px; line-height: 1.7;">The Lincoln County Sheriff's Office says its online inmate search is updated hourly.</p>
      </details>
      <details style="border:1px solid var(--slate-200); border-radius:10px; padding:14px 16px; margin-bottom:10px; background:white;">
        <summary style="font-weight:700; color:var(--navy); cursor:pointer;">Where is the Lincoln County Court Clerk?</summary>
        <p style="color: var(--slate-600); margin-top: 10px; line-height: 1.7;">811 Manvel Ave, Suite 9, Chandler, OK 74834, in the same building as the jail. Phone (405) 258-1309, open 8:00 a.m. to 4:30 p.m. Monday to Friday.</p>
      </details>
      <details style="border:1px solid var(--slate-200); border-radius:10px; padding:14px 16px; margin-bottom:10px; background:white;">
        <summary style="font-weight:700; color:var(--navy); cursor:pointer;">How do I put money on a Lincoln County inmate's account?</summary>
        <p style="color: var(--slate-600); margin-top: 10px; line-height: 1.7;">Use the Prodigy kiosk in the Sheriff's Office lobby with cash or a credit card, or bring a money order. In-person deposits are 8:30 a.m. to 4:30 p.m. Monday to Friday.</p>
      </details>
      <details style="border:1px solid var(--slate-200); border-radius:10px; padding:14px 16px; margin-bottom:10px; background:white;">
        <summary style="font-weight:700; color:var(--navy); cursor:pointer;">How many video visits are allowed at Lincoln County Jail?</summary>
        <p style="color: var(--slate-600); margin-top: 10px; line-height: 1.7;">Two visits per day, 20 minutes each, scheduled through Prodigy at least 24 hours in advance, with up to three visitors including children.</p>
      </details>
    </div>
  </section>

  <section style="padding: 28px 1.5rem; background: white;">
    <div style="max-width: 820px; margin: 0 auto;">
      <p style="font-size: 0.8rem; color: var(--slate-400); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;">Official sources</p>
      <ul style="font-size: 0.85rem; line-height: 1.8; padding-left: 1.1rem; list-style: disc;">
        <li><a href="https://lincolncountysheriffok.gov/inmate-search" rel="nofollow noopener" target="_blank" style="color: var(--blue);">Lincoln County Sheriff: Inmate Search</a></li>
        <li><a href="https://lincolncountysheriffok.gov/contact-us" rel="nofollow noopener" target="_blank" style="color: var(--blue);">Lincoln County Sheriff: Contact Us</a></li>
        <li><a href="https://lincolncountysheriffok.gov/commissary" rel="nofollow noopener" target="_blank" style="color: var(--blue);">Lincoln County Sheriff: Commissary</a></li>
        <li><a href="https://lincolncountysheriffok.gov/visitation" rel="nofollow noopener" target="_blank" style="color: var(--blue);">Lincoln County Sheriff: Visitation</a></li>
        <li><a href="https://www.lincolncountyok.gov/courtclerk" rel="nofollow noopener" target="_blank" style="color: var(--blue);">Lincoln County Court Clerk</a></li>
      </ul>
      <p style="font-size: 0.8rem; color: var(--slate-400); margin-top: 10px;">Angel Bail Bonds is a private bail bond company and is not affiliated with the Lincoln County Sheriff's Office.</p>
    </div>
  </section>

  <section style="padding: 0 1.5rem 28px; background: white;">
    <div style="max-width: 820px; margin: 0 auto;">
      <p style="font-size: 0.8rem; color: var(--slate-400); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;">Related</p>
      <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        <a href="/payne-county-inmate-search" style="font-size: 0.85rem; color: var(--blue); text-decoration: none; padding: 6px 14px; background: white; border: 1px solid var(--slate-100); border-radius: 6px;">Payne County Inmate Search →</a>
        <a href="/lincoln-county-jail-chandler-bail-bonds" style="font-size: 0.85rem; color: var(--blue); text-decoration: none; padding: 6px 14px; background: white; border: 1px solid var(--slate-100); border-radius: 6px;">Lincoln County Jail Bail Bonds →</a>
        <a href="/lincoln-county-bail-bonds" style="font-size: 0.85rem; color: var(--blue); text-decoration: none; padding: 6px 14px; background: white; border: 1px solid var(--slate-100); border-radius: 6px;">Lincoln County Bail Bonds →</a>
        <a href="/pawnee-county-inmate-search" style="font-size: 0.85rem; color: var(--blue); text-decoration: none; padding: 6px 14px; background: white; border: 1px solid var(--slate-100); border-radius: 6px;">Pawnee County Inmate Search →</a>
        <a href="/noble-county-inmate-search" style="font-size: 0.85rem; color: var(--blue); text-decoration: none; padding: 6px 14px; background: white; border: 1px solid var(--slate-100); border-radius: 6px;">Noble County Inmate Search →</a>
      </div>
    </div>
  </section>

  <section style="background: var(--navy-deep); padding: 36px 1.5rem;">
    <div style="max-width: 820px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
      <div>
        <p style="color: white; font-size: 1.1rem; font-weight: 700; margin-bottom: 2px;">Found them in Lincoln County Jail?</p>
        <p style="color: rgba(255,255,255,0.55); font-size: 0.85rem;">Open 24 hours · 7 days a week</p>
      </div>
      <a href="tel:+14056143000" class="btn-primary" style="font-size: 1rem; padding: 12px 28px; white-space: nowrap;">Call (405) 614-3000</a>
    </div>
  </section>
</BaseLayout>
