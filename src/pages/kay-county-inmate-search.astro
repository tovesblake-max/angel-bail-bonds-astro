---
import BaseLayout from '../layouts/BaseLayout.astro';

const faqData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Does Kay County have an online inmate roster?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. The Kay County Sheriff's Office does not post one. Call the Kay County Detention Facility at (580) 362-3393 or Angel Bail Bonds at (405) 614-3000."
      }
    },
    {
      "@type": "Question",
      "name": "What is the phone number for the Kay County jail?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Sheriff's Office lists (580) 362-3393 for the Kay County Detention Facility. The Sheriff's main line is (580) 362-3250."
      }
    },
    {
      "@type": "Question",
      "name": "Where do I look up a Kay County court case?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "On OSCN, the Oklahoma courts' public docket. Choose Kay County District Court and search by name. The Kay County Court Clerk is at (580) 362-3350."
      }
    },
    {
      "@type": "Question",
      "name": "Can Angel Bail Bonds post bail in Kay County?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Call (405) 614-3000 any time. We start the paperwork by phone and handle the bond with the jail."
      }
    }
  ]
};
const breadcrumbData = {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://stillwaterokbailbonds.com/"}, {"@type": "ListItem", "position": 2, "name": "Kay County Bail Bonds", "item": "https://stillwaterokbailbonds.com/kay-county-bail-bonds"}, {"@type": "ListItem", "position": 3, "name": "Kay County Inmate Search", "item": "https://stillwaterokbailbonds.com/kay-county-inmate-search"}]};
const webPageData = {"@context": "https://schema.org", "@type": "WebPage", "name": "Kay County Inmate Search", "url": "https://stillwaterokbailbonds.com/kay-county-inmate-search", "dateModified": "2026-11-15", "about": {"@type": "GovernmentBuilding", "name": "Kay County Sheriff's Office", "address": {"@type": "PostalAddress", "streetAddress": "1101 W Dry Road", "addressLocality": "Newkirk", "postalCode": "74647", "addressRegion": "OK", "addressCountry": "US"}, "telephone": "+1-580-362-3250"}, "publisher": {"@type": "LocalBusiness", "name": "Angel Bail Bonds", "telephone": "+1-405-614-3000", "address": {"@type": "PostalAddress", "streetAddress": "800 E 6th Ave, Ste Z", "addressLocality": "Stillwater", "addressRegion": "OK", "postalCode": "74075", "addressCountry": "US"}}};
---

<BaseLayout
  title="Kay County Inmate Search | Kay County Detention Facility, Newkirk OK"
  description="Kay County has no online jail roster. Here is how to find out if someone is held at the Kay County Detention Facility in Newkirk: the jail's number, OSCN court records and the Court Clerk. Bail help 24/7: (405) 614-3000."
  structuredData={webPageData}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqData)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />

  <section style="background: linear-gradient(135deg, var(--navy-deep) 0%, var(--navy) 100%); padding: 52px 1.5rem 44px;">
    <div style="max-width: 820px; margin: 0 auto;">
      <p style="color: rgba(255,255,255,0.55); font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 10px;"><a href="/kay-county-bail-bonds" style="color: inherit;">Kay County Bail Bonds</a> › Inmate Search</p>
      <h1 style="color: white; font-size: clamp(1.6rem, 4vw, 2.3rem); line-height: 1.2; font-weight: 800; margin-bottom: 14px;">Kay County Inmate Search</h1>
      <p style="color: rgba(255,255,255,0.8); font-size: 1.02rem; line-height: 1.7; margin-bottom: 22px;">Kay County does not publish an online inmate roster. The Sheriff's Office lists a direct number for the Kay County Detention Facility, so the quickest way to check on someone held in Newkirk, Ponca City or Blackwell is to call the jail, or call us and we will do it for you.</p>
      <div style="display:flex; gap:12px; flex-wrap:wrap;">
        <a href="tel:+15803623393" class="btn-primary" style="background: white; color: var(--navy); padding: 12px 22px;">Call the jail: (580) 362-3393</a>
        <a href="tel:+14056143000" class="btn-primary" style="padding: 12px 22px;">Call us to find them: (405) 614-3000</a>
      </div>
    </div>
  </section>

  <section style="padding: 40px 1.5rem; background: white;">
    <div style="max-width: 820px; margin: 0 auto;">
      <h2 style="color: var(--navy); font-size: 1.35rem; font-weight: 800; margin-bottom: 14px;">How to look someone up in Kay County</h2>
      <ol style="color: var(--slate-600); line-height: 1.7; padding-left: 1.2rem; list-style: decimal;">
        <li style="margin-bottom:10px;">Call the Kay County Detention Facility at <a href="tel:+15803623393" style="color: var(--blue);">(580) 362-3393</a> and ask whether the person is in custody. Have their full name and date of birth ready.</li>
        <li style="margin-bottom:10px;">If you cannot get through, call the Kay County Sheriff's Office at <a href="tel:+15803623250" style="color: var(--blue);">(580) 362-3250</a>.</li>
        <li style="margin-bottom:10px;">Once charges are filed, look up the case on <a href="https://www.oscn.net/dockets/Search.aspx" rel="nofollow noopener" target="_blank" style="color: var(--blue);">OSCN</a>. Pick "Kay County District Court" and search by name. A new arrest may not show a case for a day or two.</li>
        <li style="margin-bottom:10px;">Call Angel Bail Bonds at <a href="tel:+14056143000" style="color: var(--blue);">(405) 614-3000</a>, day or night. We confirm the bond and start the release by phone, so you do not have to drive to Newkirk first.</li>
      </ol>
    </div>
  </section>

  <section style="padding: 40px 1.5rem; background: var(--slate-50);">
    <div style="max-width: 820px; margin: 0 auto;">
      <h2 style="color: var(--navy); font-size: 1.35rem; font-weight: 800; margin-bottom: 14px;">Kay County at a glance</h2>
      <div style="overflow-x:auto;"><table style="width:100%; border-collapse:collapse; background:white; border:1px solid var(--slate-200); border-radius:10px; font-size:0.95rem;">
        <tbody>
          <tr><th scope="row" style="text-align:left; padding:10px 12px; color:var(--navy); font-weight:700; vertical-align:top; width:34%;">Online jail roster</th><td style="padding:10px 12px; color:var(--slate-600);">None. The Sheriff's site has no inmate search.</td></tr>
          <tr><th scope="row" style="text-align:left; padding:10px 12px; color:var(--navy); font-weight:700; vertical-align:top; width:34%;">Detention Facility</th><td style="padding:10px 12px; color:var(--slate-600);"><a href="tel:+15803623393" style="color: var(--blue);">(580) 362-3393</a></td></tr>
          <tr><th scope="row" style="text-align:left; padding:10px 12px; color:var(--navy); font-weight:700; vertical-align:top; width:34%;">Sheriff's Office</th><td style="padding:10px 12px; color:var(--slate-600);">1101 W Dry Road, Newkirk, OK 74647 · <a href="tel:+15803623250" style="color: var(--blue);">(580) 362-3250</a></td></tr>
          <tr><th scope="row" style="text-align:left; padding:10px 12px; color:var(--navy); font-weight:700; vertical-align:top; width:34%;">Court records</th><td style="padding:10px 12px; color:var(--slate-600);"><a href="https://www.oscn.net/dockets/Search.aspx" rel="nofollow noopener" target="_blank" style="color: var(--blue);">OSCN docket search</a>, Kay County District Court</td></tr>
          <tr><th scope="row" style="text-align:left; padding:10px 12px; color:var(--navy); font-weight:700; vertical-align:top; width:34%;">Court Clerk</th><td style="padding:10px 12px; color:var(--slate-600);">201 S. Main St., Newkirk · <a href="tel:+15803623350" style="color: var(--blue);">(580) 362-3350</a> · 8:00 to 12:00 and 12:45 to 4:30, Monday to Friday</td></tr>
        </tbody>
      </table></div>
      <p style="color: var(--slate-500); font-size: 0.82rem; margin-top: 10px;">Checked against the official pages listed at the bottom of this page on November 15, 2026. Call before you drive, since offices change hours.</p>
    </div>
  </section>

  <section style="padding: 40px 1.5rem; background: white;">
    <div style="max-width: 820px; margin: 0 auto;">
      <h2 style="color: var(--navy); font-size: 1.35rem; font-weight: 800; margin-bottom: 14px;">What the Kay County Sheriff's site does and doesn't have</h2>
      <p style="color: var(--slate-600); line-height: 1.75; margin-bottom: 12px;">The Kay County Sheriff's Office pages on the county website list the Detention Facility's phone number but no jail roster. The "Offender Watch" link there is a sex-offender lookup, not a list of who is in jail, so it will not tell you whether someone was booked last night.</p>
      <p style="color: var(--slate-600); line-height: 1.75; margin-bottom: 12px;">The Court Clerk's office closes for lunch from 12:00 to 12:45, so plan calls and visits around that.</p>
    </div>
  </section>
  <section style="padding: 40px 1.5rem; background: var(--slate-50);">
    <div style="max-width: 820px; margin: 0 auto;">
      <h2 style="color: var(--navy); font-size: 1.35rem; font-weight: 800; margin-bottom: 14px;">Checking the court case</h2>
      <p style="color: var(--slate-600); line-height: 1.75; margin-bottom: 12px;"><a href="https://www.oscn.net/dockets/Search.aspx" rel="nofollow noopener" target="_blank" style="color: var(--blue);">OSCN</a> is the Oklahoma courts' own public docket, and it covers Kay County District Court. It shows the charges, the case number, hearing dates and, once it is set, the bond.</p>
      <p style="color: var(--slate-600); line-height: 1.75; margin-bottom: 12px;">Oklahoma VINE, run through the <a href="https://oklahoma.gov/oag/about/divisions/victim-advocacy-and-services-unit/ok-vine.html" rel="nofollow noopener" target="_blank" style="color: var(--blue);">Attorney General's office</a>, sends custody alerts by phone, text or email (toll-free 877-654-8463). We could not confirm that VINE lists this jail, so call the jail first.</p>
    </div>
  </section>

  <section style="padding: 40px 1.5rem; background: var(--slate-50);">
    <div style="max-width: 820px; margin: 0 auto;">
      <h2 style="color: var(--navy); font-size: 1.35rem; font-weight: 800; margin-bottom: 14px;">Questions families ask</h2>
      <details style="border:1px solid var(--slate-200); border-radius:10px; padding:14px 16px; margin-bottom:10px; background:white;">
        <summary style="font-weight:700; color:var(--navy); cursor:pointer;">Does Kay County have an online inmate roster?</summary>
        <p style="color: var(--slate-600); margin-top: 10px; line-height: 1.7;">No. The Kay County Sheriff's Office does not post one. Call the Kay County Detention Facility at (580) 362-3393 or Angel Bail Bonds at (405) 614-3000.</p>
      </details>
      <details style="border:1px solid var(--slate-200); border-radius:10px; padding:14px 16px; margin-bottom:10px; background:white;">
        <summary style="font-weight:700; color:var(--navy); cursor:pointer;">What is the phone number for the Kay County jail?</summary>
        <p style="color: var(--slate-600); margin-top: 10px; line-height: 1.7;">The Sheriff's Office lists (580) 362-3393 for the Kay County Detention Facility. The Sheriff's main line is (580) 362-3250.</p>
      </details>
      <details style="border:1px solid var(--slate-200); border-radius:10px; padding:14px 16px; margin-bottom:10px; background:white;">
        <summary style="font-weight:700; color:var(--navy); cursor:pointer;">Where do I look up a Kay County court case?</summary>
        <p style="color: var(--slate-600); margin-top: 10px; line-height: 1.7;">On OSCN, the Oklahoma courts' public docket. Choose Kay County District Court and search by name. The Kay County Court Clerk is at (580) 362-3350.</p>
      </details>
      <details style="border:1px solid var(--slate-200); border-radius:10px; padding:14px 16px; margin-bottom:10px; background:white;">
        <summary style="font-weight:700; color:var(--navy); cursor:pointer;">Can Angel Bail Bonds post bail in Kay County?</summary>
        <p style="color: var(--slate-600); margin-top: 10px; line-height: 1.7;">Yes. Call (405) 614-3000 any time. We start the paperwork by phone and handle the bond with the jail.</p>
      </details>
    </div>
  </section>

  <section style="padding: 28px 1.5rem; background: white;">
    <div style="max-width: 820px; margin: 0 auto;">
      <p style="font-size: 0.8rem; color: var(--slate-400); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;">Official sources</p>
      <ul style="font-size: 0.85rem; line-height: 1.8; padding-left: 1.1rem; list-style: disc;">
        <li><a href="https://www.courthouse.kay.ok.us/185/Contact-Information" rel="nofollow noopener" target="_blank" style="color: var(--blue);">Kay County Sheriff's Office: Contact Information</a></li>
        <li><a href="https://www.courthouse.kay.ok.us/176/Kay-County-Sheriffs-Office" rel="nofollow noopener" target="_blank" style="color: var(--blue);">Kay County Sheriff's Office</a></li>
        <li><a href="https://www.courthouse.kay.ok.us/171/Court-Clerk" rel="nofollow noopener" target="_blank" style="color: var(--blue);">Kay County Court Clerk</a></li>
        <li><a href="https://www.oscn.net/dockets/Search.aspx" rel="nofollow noopener" target="_blank" style="color: var(--blue);">OSCN: Oklahoma State Courts Network docket search</a></li>
        <li><a href="https://oklahoma.gov/oag/about/divisions/victim-advocacy-and-services-unit/ok-vine.html" rel="nofollow noopener" target="_blank" style="color: var(--blue);">Oklahoma Attorney General: OK VINE</a></li>
      </ul>
      <p style="font-size: 0.8rem; color: var(--slate-400); margin-top: 10px;">Angel Bail Bonds is a private bail bond company and is not affiliated with the Kay County Sheriff's Office.</p>
    </div>
  </section>

  <section style="padding: 0 1.5rem 28px; background: white;">
    <div style="max-width: 820px; margin: 0 auto;">
      <p style="font-size: 0.8rem; color: var(--slate-400); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;">Related</p>
      <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        <a href="/kay-county-detention-center-bail-bonds" style="font-size: 0.85rem; color: var(--blue); text-decoration: none; padding: 6px 14px; background: white; border: 1px solid var(--slate-100); border-radius: 6px;">Kay County Detention Center Bail Bonds →</a>
        <a href="/kay-county-bail-bonds" style="font-size: 0.85rem; color: var(--blue); text-decoration: none; padding: 6px 14px; background: white; border: 1px solid var(--slate-100); border-radius: 6px;">Kay County Bail Bonds →</a>
        <a href="/noble-county-inmate-search" style="font-size: 0.85rem; color: var(--blue); text-decoration: none; padding: 6px 14px; background: white; border: 1px solid var(--slate-100); border-radius: 6px;">Noble County Inmate Search →</a>
        <a href="/payne-county-inmate-search" style="font-size: 0.85rem; color: var(--blue); text-decoration: none; padding: 6px 14px; background: white; border: 1px solid var(--slate-100); border-radius: 6px;">Payne County Inmate Search →</a>
      </div>
    </div>
  </section>

  <section style="background: var(--navy-deep); padding: 36px 1.5rem;">
    <div style="max-width: 820px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
      <div>
        <p style="color: white; font-size: 1.1rem; font-weight: 700; margin-bottom: 2px;">Need someone out of jail in Kay County?</p>
        <p style="color: rgba(255,255,255,0.55); font-size: 0.85rem;">Open 24 hours · We start the paperwork by phone</p>
      </div>
      <a href="tel:+14056143000" class="btn-primary" style="font-size: 1rem; padding: 12px 28px; white-space: nowrap;">Call (405) 614-3000</a>
    </div>
  </section>
</BaseLayout>
