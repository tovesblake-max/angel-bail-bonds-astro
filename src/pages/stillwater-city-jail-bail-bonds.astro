---
import BaseLayout from '../layouts/BaseLayout.astro';

const faqData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is the Stillwater City Jail still open?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. The City of Stillwater announced on March 19, 2026 that it would contract with Payne County for jail services starting July 1, 2026, and close the city jail."
      }
    },
    {
      "@type": "Question",
      "name": "Where do Stillwater police take people they arrest now?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "To Payne County custody, since Payne County took over the city's jail services on July 1, 2026. Call the Payne County Sheriff's Office at (405) 372-4522 to check on someone."
      }
    },
    {
      "@type": "Question",
      "name": "How do I bail someone out after a Stillwater arrest?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Call Angel Bail Bonds at (405) 614-3000 any time. We find out where they are held, confirm the bond with Payne County and start the paperwork by phone."
      }
    }
  ]
};
const breadcrumbData = {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://stillwaterokbailbonds.com/"}, {"@type": "ListItem", "position": 2, "name": "Payne County Jail Bail Bonds", "item": "https://stillwaterokbailbonds.com/payne-county-jail-bail-bonds"}, {"@type": "ListItem", "position": 3, "name": "Stillwater City Jail: Arrests Now Go to Payne County", "item": "https://stillwaterokbailbonds.com/stillwater-city-jail-bail-bonds"}]};
const webPageData = {"@context": "https://schema.org", "@type": "WebPage", "name": "Stillwater City Jail: Arrests Now Go to Payne County", "url": "https://stillwaterokbailbonds.com/stillwater-city-jail-bail-bonds", "dateModified": "2026-11-16", "about": {"@type": "GovernmentBuilding", "name": "Payne County Sheriff's Office", "telephone": "+1-405-372-4522"}, "publisher": {"@type": "LocalBusiness", "name": "Angel Bail Bonds", "telephone": "+1-405-614-3000", "address": {"@type": "PostalAddress", "streetAddress": "800 E 6th Ave, Ste Z", "addressLocality": "Stillwater", "addressRegion": "OK", "postalCode": "74075", "addressCountry": "US"}}};
---

<BaseLayout
  title="Stillwater City Jail Closed: Stillwater Arrests Now Go to Payne County"
  description="The Stillwater City Jail closed when Payne County took over the city's jail services on July 1, 2026. Here is how to find someone arrested by Stillwater police and get them out. Bail help 24/7: (405) 614-3000."
  structuredData={webPageData}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqData)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />

  <section style="background: linear-gradient(135deg, var(--navy-deep) 0%, var(--navy) 100%); padding: 52px 1.5rem 44px;">
    <div style="max-width: 820px; margin: 0 auto;">
      <p style="color: rgba(255,255,255,0.55); font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 10px;"><a href="/payne-county-jail-bail-bonds" style="color: inherit;">Payne County Jail Bail Bonds</a> › Stillwater City Jail</p>
      <h1 style="color: white; font-size: clamp(1.6rem, 4vw, 2.3rem); line-height: 1.2; font-weight: 800; margin-bottom: 14px;">Stillwater City Jail: Arrests Now Go to Payne County</h1>
      <p style="color: rgba(255,255,255,0.8); font-size: 1.02rem; line-height: 1.7; margin-bottom: 22px;">The City of Stillwater announced on March 19, 2026 that it would close the city jail and contract with Payne County for jail services starting July 1, 2026. If someone was arrested by Stillwater police, Payne County now holds them. Call us and we will find them and start the bond.</p>
      <div style="display:flex; gap:12px; flex-wrap:wrap;">
        <a href="https://stillwaterok.gov/m/newsflash/Home/Detail/470" rel="nofollow noopener" target="_blank" class="btn-primary" style="background: white; color: var(--navy); padding: 12px 22px;">Read the city's announcement ↗</a>
        <a href="tel:+14056143000" class="btn-primary" style="padding: 12px 22px;">Call us to find them: (405) 614-3000</a>
      </div>
    </div>
  </section>

  <section style="padding: 40px 1.5rem; background: white;">
    <div style="max-width: 820px; margin: 0 auto;">
      <h2 style="color: var(--navy); font-size: 1.35rem; font-weight: 800; margin-bottom: 14px;">How to look someone up in Stillwater</h2>
      <ol style="color: var(--slate-600); line-height: 1.7; padding-left: 1.2rem; list-style: decimal;">
        <li style="margin-bottom:10px;">Call the Payne County Sheriff's Office at <a href="tel:+14053724522" style="color: var(--blue);">(405) 372-4522</a> with the person's full name and date of birth, and ask whether they are in custody.</li>
        <li style="margin-bottom:10px;">Once charges are filed, find the case on <a href="https://www.oscn.net/dockets/Search.aspx" rel="nofollow noopener" target="_blank" style="color: var(--blue);">OSCN</a> under Payne County District Court. Our <a href="/payne-county-inmate-search" style="color: var(--blue);">Payne County inmate search guide</a> covers this and the Court Clerk.</li>
        <li style="margin-bottom:10px;">Call Angel Bail Bonds at <a href="tel:+14056143000" style="color: var(--blue);">(405) 614-3000</a>, day or night. We confirm the bond and start the release by phone.</li>
      </ol>
    </div>
  </section>

  <section style="padding: 40px 1.5rem; background: var(--slate-50);">
    <div style="max-width: 820px; margin: 0 auto;">
      <h2 style="color: var(--navy); font-size: 1.35rem; font-weight: 800; margin-bottom: 14px;">Stillwater at a glance</h2>
      <div style="overflow-x:auto;"><table style="width:100%; border-collapse:collapse; background:white; border:1px solid var(--slate-200); border-radius:10px; font-size:0.95rem;">
        <tbody>
          <tr><th scope="row" style="text-align:left; padding:10px 12px; color:var(--navy); font-weight:700; vertical-align:top; width:34%;">City jail</th><td style="padding:10px 12px; color:var(--slate-600);">Closed. Payne County took over jail services on July 1, 2026, according to the City of Stillwater.</td></tr>
          <tr><th scope="row" style="text-align:left; padding:10px 12px; color:var(--navy); font-weight:700; vertical-align:top; width:34%;">Who holds Stillwater arrests now</th><td style="padding:10px 12px; color:var(--slate-600);">Payne County</td></tr>
          <tr><th scope="row" style="text-align:left; padding:10px 12px; color:var(--navy); font-weight:700; vertical-align:top; width:34%;">Payne County Sheriff's Office</th><td style="padding:10px 12px; color:var(--slate-600);"><a href="tel:+14053724522" style="color: var(--blue);">(405) 372-4522</a></td></tr>
          <tr><th scope="row" style="text-align:left; padding:10px 12px; color:var(--navy); font-weight:700; vertical-align:top; width:34%;">Online roster</th><td style="padding:10px 12px; color:var(--slate-600);">Payne County has none right now. Call the Sheriff's Office or call us.</td></tr>
        </tbody>
      </table></div>
      <p style="color: var(--slate-500); font-size: 0.82rem; margin-top: 10px;">Checked against the official pages listed at the bottom of this page on November 16, 2026.</p>
    </div>
  </section>

  <section style="padding: 40px 1.5rem; background: white;">
    <div style="max-width: 820px; margin: 0 auto;">
      <h2 style="color: var(--navy); font-size: 1.35rem; font-weight: 800; margin-bottom: 14px;">What changed</h2>
      <p style="color: var(--slate-600); line-height: 1.75; margin-bottom: 12px;">Until mid-2026 the Stillwater Police Department ran its own short-term jail. In a <a href="https://stillwaterok.gov/m/newsflash/Home/Detail/470" rel="nofollow noopener" target="_blank" style="color: var(--blue);">March 19, 2026 announcement</a>, the city said it would contract with Payne County for jail services beginning July 1, 2026. Police Chief Chris Hassig and Sheriff Joe Harper both described it as centralizing jail services with the county.</p>
      <p style="color: var(--slate-600); line-height: 1.75; margin-bottom: 12px;">So older advice about "the city jail" no longer applies. If a Stillwater officer made the arrest, the person is in Payne County custody, and the bond goes through Payne County.</p>
    </div>
  </section>
  <section style="padding: 40px 1.5rem; background: var(--slate-50);">
    <div style="max-width: 820px; margin: 0 auto;">
      <h2 style="color: var(--navy); font-size: 1.35rem; font-weight: 800; margin-bottom: 14px;">Arrested by OSU police or a deputy?</h2>
      <p style="color: var(--slate-600); line-height: 1.75; margin-bottom: 12px;">Arrests by the Payne County Sheriff's Office were already booked into Payne County, so nothing changes there. If you are not sure which agency made the arrest, call us with the person's name and we will find out where they are.</p>
    </div>
  </section>

  <section style="padding: 40px 1.5rem; background: var(--slate-50);">
    <div style="max-width: 820px; margin: 0 auto;">
      <h2 style="color: var(--navy); font-size: 1.35rem; font-weight: 800; margin-bottom: 14px;">Questions families ask</h2>
      <details style="border:1px solid var(--slate-200); border-radius:10px; padding:14px 16px; margin-bottom:10px; background:white;">
        <summary style="font-weight:700; color:var(--navy); cursor:pointer;">Is the Stillwater City Jail still open?</summary>
        <p style="color: var(--slate-600); margin-top: 10px; line-height: 1.7;">No. The City of Stillwater announced on March 19, 2026 that it would contract with Payne County for jail services starting July 1, 2026, and close the city jail.</p>
      </details>
      <details style="border:1px solid var(--slate-200); border-radius:10px; padding:14px 16px; margin-bottom:10px; background:white;">
        <summary style="font-weight:700; color:var(--navy); cursor:pointer;">Where do Stillwater police take people they arrest now?</summary>
        <p style="color: var(--slate-600); margin-top: 10px; line-height: 1.7;">To Payne County custody, since Payne County took over the city's jail services on July 1, 2026. Call the Payne County Sheriff's Office at (405) 372-4522 to check on someone.</p>
      </details>
      <details style="border:1px solid var(--slate-200); border-radius:10px; padding:14px 16px; margin-bottom:10px; background:white;">
        <summary style="font-weight:700; color:var(--navy); cursor:pointer;">How do I bail someone out after a Stillwater arrest?</summary>
        <p style="color: var(--slate-600); margin-top: 10px; line-height: 1.7;">Call Angel Bail Bonds at (405) 614-3000 any time. We find out where they are held, confirm the bond with Payne County and start the paperwork by phone.</p>
      </details>
    </div>
  </section>

  <section style="padding: 28px 1.5rem; background: white;">
    <div style="max-width: 820px; margin: 0 auto;">
      <p style="font-size: 0.8rem; color: var(--slate-400); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;">Official sources</p>
      <ul style="font-size: 0.85rem; line-height: 1.8; padding-left: 1.1rem; list-style: disc;">
        <li><a href="https://stillwaterok.gov/m/newsflash/Home/Detail/470" rel="nofollow noopener" target="_blank" style="color: var(--blue);">City of Stillwater: City to Contract with Payne County for Jail Services (Mar 19, 2026)</a></li>
        <li><a href="https://www.paynecounty.org/general-information" rel="nofollow noopener" target="_blank" style="color: var(--blue);">Payne County: General Information (Sheriff phone)</a></li>
        <li><a href="https://www.oscn.net/dockets/Search.aspx" rel="nofollow noopener" target="_blank" style="color: var(--blue);">OSCN: Oklahoma State Courts Network docket search</a></li>
      </ul>
      <p style="font-size: 0.8rem; color: var(--slate-400); margin-top: 10px;">Angel Bail Bonds is a private bail bond company and is not affiliated with the City of Stillwater or the Payne County Sheriff's Office.</p>
    </div>
  </section>

  <section style="padding: 0 1.5rem 28px; background: white;">
    <div style="max-width: 820px; margin: 0 auto;">
      <p style="font-size: 0.8rem; color: var(--slate-400); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;">Related</p>
      <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        <a href="/payne-county-inmate-search" style="font-size: 0.85rem; color: var(--blue); text-decoration: none; padding: 6px 14px; background: white; border: 1px solid var(--slate-100); border-radius: 6px;">Payne County Inmate Search →</a>
        <a href="/payne-county-jail-bail-bonds" style="font-size: 0.85rem; color: var(--blue); text-decoration: none; padding: 6px 14px; background: white; border: 1px solid var(--slate-100); border-radius: 6px;">Payne County Jail Bail Bonds →</a>
        <a href="/payne-county-detention-center-bail-bonds" style="font-size: 0.85rem; color: var(--blue); text-decoration: none; padding: 6px 14px; background: white; border: 1px solid var(--slate-100); border-radius: 6px;">Payne County Detention Center →</a>
      </div>
    </div>
  </section>

  <section style="background: var(--navy-deep); padding: 36px 1.5rem;">
    <div style="max-width: 820px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
      <div>
        <p style="color: white; font-size: 1.1rem; font-weight: 700; margin-bottom: 2px;">Someone arrested in Stillwater?</p>
        <p style="color: rgba(255,255,255,0.55); font-size: 0.85rem;">Open 24 hours · We start the paperwork by phone</p>
      </div>
      <a href="tel:+14056143000" class="btn-primary" style="font-size: 1rem; padding: 12px 28px; white-space: nowrap;">Call (405) 614-3000</a>
    </div>
  </section>
</BaseLayout>
